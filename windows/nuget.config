<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only nuget.org: a machine-wide offline source that does not exist (Visual Studio's NuGetPackages folder) no longer stops the restore. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
