<Project Sdk="Microsoft.NET.Sdk">

  <!-- Seven Friends for Windows: a WPF window with the Microsoft Edge WebView2 control that shows the live web app. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms> <!-- only for the tray icon (NotifyIcon) -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SevenFriends</AssemblyName>
    <RootNamespace>SevenFriends</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Seven Friends</Product>
    <Company>Blueboot R&amp;D AS</Company>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- WPF and Windows Forms share names (Application, MessageBox...): only WPF is used by name, Forms is always written in full -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <!-- the icon is also used by the installer (installer/SevenFriends.iss) -->
  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
