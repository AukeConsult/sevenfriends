# Settings of the backend. Copy this file to `.env` (not committed) and change what you want.
# Every line is optional: without it the default (shown here) is used.
# A literal \n is a new line. Do NOT put secrets in this file.

# Where people go to sign up: the link in the invitation email / SMS
APP_URL=https://sevenfriends.web.app/

# The invitation email (the only invitation: text messages are only used for login codes).
# Places you can use: {fromName} {message} {to} {appUrl} {appName} {inviteUrl}
#   {fromName} the sender's name      {message} their message in quotes (empty when none)
#   {to} the email address invited      {appUrl} the link above
INVITE_EMAIL_SUBJECT={fromName} invited you to {appName}
INVITE_EMAIL_TEXT={fromName} wants you as one of their 7 closest friends on {appName}.\n\n{message}\n\nSign up with this email address ({to}) to see the request: {inviteUrl}


# ---- Sending email through YOUR OWN mail server (SMTP) --------------------------------------
# A function (sendMail) sends every document written to the `mail` collection, such as the invitation emails.
# Email is only sent when SMTP_HOST and MAIL_FROM are set; otherwise the mail document gets
# delivery.state = ERROR with the reason. These values are plain settings (not Firebase secrets), so keep this file private.
SMTP_HOST=
SMTP_PORT=587
# true = encrypted from the start (usually port 465); false = STARTTLS (usually port 587). Leave empty to decide by the port.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# The sender shown to the receiver, for example: Seven Friends <noreply@yourdomain.com>
MAIL_FROM=
# The region of the trigger: it must match where your Firestore database is (Firebase console -> Firestore -> Settings)
MAIL_TRIGGER_REGION=europe-west1

# How the invitation email LOOKS (HTML): the file, relative to the functions folder. Edit that file to change the design;
# see assets/mail/README.md. Delete the file (or point to a missing one) to send text only.
INVITE_EMAIL_TEMPLATE=assets/mail/invite.html

# How many times one person can ask a friend for key recovery in a day. 0 = no limit (off while it is being tested; the plan is 3).
RECOVERY_ASKS_PER_DAY=0
