<?xml version="1.0" encoding="utf-8"?>
<!-- The MSIX manifest of Seven Friends for Windows. scripts/windows-msix.mjs fills in the version and publisher placeholders and packs it
     with the files of client-wrappers/windows/publish. The Publisher must be exactly the Subject of the certificate that signs the package
     (for the Microsoft Store: the Publisher shown in Partner Center). -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="BluebootRD.SevenFriends" Publisher="{{PUBLISHER}}" Version="{{VERSION}}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Seven Friends</DisplayName>
    <PublisherDisplayName>Blueboot R&amp;D AS</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="SevenFriends" Executable="SevenFriends.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Seven Friends"
        Description="Stay in contact with your 7 closest friends."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- "Seven Friends" in the Windows share dialog, for a link (URI) or text. App code: SharedContent.cs (it opens the web app's /share-in page). -->
        <uap:Extension Category="windows.shareTarget">
          <uap:ShareTarget>
            <uap:DataFormat>URI</uap:DataFormat>
            <uap:DataFormat>Text</uap:DataFormat>
          </uap:ShareTarget>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
