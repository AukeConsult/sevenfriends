# Secrets and settings for the scripts in this repo. This file is in .gitignore: never commit it, never paste it in a chat.
# This is the template (committed). Copy it to .env and fill it in.

# The Firebase project
FIREBASE_PROJECT_ID=

# The iPhone app (the bundle id in Xcode; it must be the same as in ios/App/App.xcodeproj)
IOS_BUNDLE_ID=io.sevenfriends.app

# The Android app (package name = the applicationId in android/app/build.gradle)
ANDROID_PACKAGE=io.sevenfriends.app
# Optional: the SHA-1 fingerprint of the key that signs the app (Android Studio: Gradle > android > Tasks > android > signingReport).
# Needed for Google sign-in; the script adds it to the Firebase app when it is set. Several: separate with commas.
ANDROID_SHA1=

# The service account key (Firebase console > Project settings > Service accounts > Generate new private key).
# Paste the WHOLE json file as ONE line between single quotes. Roles it needs for `npm run android:config`: Firebase Admin
# (or Firebase Viewer to only fetch the file when the Android app already exists in the project).
FIREBASE_SERVICE_ACCOUNT=''

# Android release signing (read by android/app/build.gradle). Fill in after creating the keystore; never commit.
SF_KEYSTORE=
SF_KEYSTORE_PASSWORD=
SF_KEY_ALIAS=sevenfriends
SF_KEY_PASSWORD=
