# Secrets and settings for the scripts in this repo. This file is in .gitignore: never commit it, never paste it in a chat.
# This is the template (committed). Copy it to .env and fill it in.

# The Firebase project
FIREBASE_PROJECT_ID=

# The iPhone app (the bundle id in Xcode; it must be the same as in ios/App/App.xcodeproj)
IOS_BUNDLE_ID=io.sevenfriends.app

# The Android app (package name = the applicationId in android/app/build.gradle)
ANDROID_PACKAGE=io.sevenfriends.app
# Optional: the SHA-1 fingerprint of the key that signs the app (Android Studio: Gradle > android > Tasks > android > signingReport).
# Needed for Google sign-in; the script adds it to the Firebase app when it is set. Several: separate with commas.
ANDROID_SHA1=

# The service account key (Firebase console > Project settings > Service accounts > Generate new private key).
# Paste the WHOLE json file as ONE line between single quotes. Roles it needs for `npm run android:config`: Firebase Admin
# (or Firebase Viewer to only fetch the file when the Android app already exists in the project).
FIREBASE_SERVICE_ACCOUNT=''

# Android release signing (read by client-wrappers/android/app/build.gradle). Fill in after creating the keystore; never commit.
SF_KEYSTORE=
SF_KEYSTORE_PASSWORD=
SF_KEY_ALIAS=sevenfriends
SF_KEY_PASSWORD=

# Windows MSIX package (scripts/windows-msix.mjs). Optional: without them a self-signed TEST certificate is used (cannot be shipped).
# SF_MSIX_PUBLISHER must be exactly the Subject of the certificate, e.g. "CN=Blueboot R&D AS". Never commit.
SF_MSIX_PFX=
SF_MSIX_PFX_PASSWORD=
SF_MSIX_PUBLISHER=

# SMS: phone sign-in and phone verification. on = shown, off (or not set) = hidden and no SMS is ever sent. Each SMS costs money (Firebase Blaze plan).
# Read when the frontend is built or started: restart `npm run dev:frontend` after a change.
PHONE_AUTH=off

# Stripe (one-time purchase, docs/guide/payments.md). `npm run sync:stripe` (also run before the emulators and a deploy) copies these into functions/.env.
# on = the purchase is offered, off (or not set) = it is not (the page says payment is not available; the webhook still works for payments already made)
PAYMENT=off
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# the price in the smallest currency unit (500 = 5.00) and the currency
PAYMENT_AMOUNT=500
# the least and the most one donation can be (default 500 = 5.00 and 100000 = 1000.00)
PAYMENT_MIN_AMOUNT=500
PAYMENT_MAX_AMOUNT=100000
PAYMENT_CURRENCY=eur
