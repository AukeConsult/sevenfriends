{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "sync:models": "node ../scripts/sync-models.mjs",
    "sync:sounds": "node ../scripts/sounds-manifest.mjs",
    "sync:android-sounds": "node ../scripts/sync-android-sounds.mjs",
    "prestart": "npm run sync:models && npm run sync:sounds && npm run sync:android-sounds",
    "prebuild": "npm run sync:models && npm run sync:sounds && npm run sync:android-sounds",
    "prewatch": "npm run sync:models && npm run sync:sounds && npm run sync:android-sounds",
    "pretest": "npm run sync:models"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Leif Auke <leif@auke.no> (Blueboot R&D AS)",
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@capacitor-firebase/authentication": "^8.6.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/push-notifications": "^8.1.3",
    "@jsverse/transloco": "^8.4.0",
    "@types/leaflet": "^1.9.22",
    "bootstrap": "^5.3.3",
    "docx-preview": "^0.4.1",
    "fflate": "^0.8.3",
    "firebase": "^11.10.0",
    "leaflet": "^1.9.4",
    "pdfjs-dist": "^6.5.438",
    "pptx-preview": "^1.0.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.42",
    "@angular/cli": "^20.3.42",
    "@angular/compiler-cli": "^20.3.0",
    "@capacitor/cli": "^8.6.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2"
  }
}
