rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // USER CONTROL
    // All data goes through the backend, which checks the login and only touches the caller's own data
    // (the Admin SDK ignores these rules). The app itself may only READ the live data under the
    // signed-in user's OWN account, to know when something new arrived:
    //   incoming-signal  pings that somebody added me
    //   messages         my messages (the app listens to the unread ones)
    //   friends          my own friend list (the app listens, so an answer to my request shows at once)
    //   sync             times of my last profile / sounds change, so my other devices follow
    // Nobody writes from the client, and nobody can read somebody else's data.
    //
    // The app only LISTENS to these collections (a query, `list`), it never reads a single document by its path: `get` stays closed.
    // The messages can only be listed as "the unread ones" (where read == false), which is the one query the app makes:
    // a query without that condition is refused, so the client cannot pull the whole history.
    match /user-account/{uid}/incoming-signal/{signalId} {
      allow list: if isOwner(uid);
      allow get, write: if false;
    }

    match /user-account/{uid}/messages/{messageId} {
      allow list: if isOwner(uid) && resource.data.read == false;
      allow get, write: if false;
    }

    // sync: only times ("my profile / sounds changed"), so my other devices reload them
    match /user-account/{uid}/sync/{docId} {
      allow list: if isOwner(uid);
      allow get, write: if false;
    }

    // the friend list of each of my circles (an app is in one circle and listens to that one: friends, buddies, work or family)
    match /user-account/{uid}/friend-circle/{circleId}/friends/{friendId} {
      allow list: if isOwner(uid);
      allow get, write: if false;
    }

    // everything else (profiles, circles, friends, requests, ...) is closed to the client
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
